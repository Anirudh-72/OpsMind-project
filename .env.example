# OpsMind Configuration
# Copy this file to .env and configure your keys

# Server
PORT=8000
HOST=127.0.0.1
OPSMIND_ENV=development

# Hindsight Persistent Memory (Vectorize.io)
# Cloud API: https://api.hindsight.vectorize.io (or http://localhost:8888 for local self-hosted)
HINDSIGHT_API_KEY=
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=opsmind-incidents

# LLM Provider (Groq recommended for hackathon)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
